addi    $0     $0     x7f8   //x7f8
addi    $1     $1     20   //r1= 31
sll     $0     $0     $1   //7f80 0000
addi    $2     $2     1024 
addi    $6     $8     2
sll     $2     $2     $6    //r2=2048
sll     $2     $2     $6    //r2=4096
sw      $0     $2     0      mem[0] = 7f80 0000  inf
addi    $0     $0     1     //7f80 0001
sw      $0     $2     4     mem[1] = 7f80 0001  nan
sw      $3     $2     8      // mem[2] = 0; z
addi    $4     $4     1
addi    $5     $5     31   
sll     $4     $4     $5   //r4 8000 0000
sw      $4     $2     12      // mem[3] =  8000 0000  z
addi    $3     $3     1     // 0x000 0001
sw      $3     $2     16      // mem[4] =  0000 0001  sn
addi    $4     $4     1     // 0x800 0001
sw      $4     $2     20     // mem[5] =  8000 0001  sn
addi    $8     $8     511    // 1ff
addi    $7     $7     23     // 
sll     $8     $8     $7     //ff80 0000
sw      $8     $2     24     // mem[6] =  ff80 0000 inf
sll     $0     $0     $6     //1FE00000  nn
sll     $8     $8     $6     //3FE00000  nn
sw      $0     $2     28     // mem[7] =  1FE00000 inf
sw      $8     $2     32     // mem[8] =  3FE00000 inf
eof 
